// find longest word in string

import java.util.*;

class Main {
    public static void main(String[] args) {
        String str = "Hello I am good";
        String ans = "";
        String[] arr = str.split("\\s+");
        for(int i=0; i<arr.length; i++){
            if(arr[i].length() > ans.length()){
                ans = arr[i];
            }
        }
        System.out.print(ans);
    }
}
