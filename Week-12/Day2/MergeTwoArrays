// given two unsorted arrays of different lengths, merge them in unsorted way

import java.util.*;

class Main {
    public static int[] mergeArrays(int[] arr1, int[] arr2) {
        int n1 = arr1.length;
        int n2 = arr2.length;
        int[] ans = new int[n1+n2];
        for(int i=0; i<n1; i++){
            ans[i] = arr1[i];
        }
        for(int i=0; i<n2; i++){
            ans[n1+i] = arr2[i];
        }
        return ans;
    }
    public static void main(String[] args) {
        int[] nums1 = {1,2,8};
        int[] nums2 = {2,6};

        int[] result = mergeArrays(nums1, nums2);

        for(int i=0; i<result.length; i++){
            System.out.print(result[i] + " ");
        }
    }
}
