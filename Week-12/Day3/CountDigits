
import java.util.*;

public class Main {
    public static void main(String[] args) {
        int n = 123456;
        n = Math.abs(n);
        int count = 0;
        if (n == 0) {
            count = 1;
        } else {
            while (n > 0) {
                count++;
                n = n / 10;
            }
        }
        System.out.println(count);
    }
}
