// given 2 sorted arrays, merge them in sorted way
import java.util.*;

public class Main {
    public static void main(String[] args) {
        int[] arr1 = {1, 2, 3};
        int[] arr2 = {4, 5, 6, 9};
        int n = arr1.length;
        int m = arr2.length;
        int[] merged = new int[n + m];
        int i = 0, j = 0, k = 0;
        while (i < n && j < m) {
            if (arr1[i] < arr2[j]) {
                merged[k] = arr1[i];
                i++;
            } else {
                merged[k] = arr2[j];
                j++;
            }
            k++;
        }
        while (i < n) {
            merged[k] = arr1[i];
            i++;
            k++;
        }
        while (j < m) {
            merged[k] = arr2[j];
            j++;
            k++;
        }
        for(int a=0; a<merged.length; a++){
            System.out.print(merged[a] + " ");
        }
    }
}
