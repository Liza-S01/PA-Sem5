        // reverse string
        Deque<Character> dq = new ArrayDeque<>();
        String s = "HELLO";
        for(int i=0; i<s.length(); i++){
            dq.addFirst(s.charAt(i));
        }
        StringBuilder sb = new StringBuilder();
        while(!dq.isEmpty()){
            sb.append(dq.removeFirst());
        }
        System.out.println("Original: " + s);
        System.out.println("Reversed: " + sb);

